+static int valid_resolve_hostname(const u8_t *hostname, u16_t hostname_length)
+{
+	u16_t position, label_length = 0;
+
+	if (!hostname_length || hostname_length > 253)
+		return 0;
+	for (position = 0; position < hostname_length; position++) {
+		u8_t character = hostname[position];
+
+		if (character == '.') {
+			if (!label_length || hostname[position - 1] == '-')
+				return 0;
+			label_length = 0;
+			continue;
+		}
+		if (!((character >= 'a' && character <= 'z') ||
+		    (character >= 'A' && character <= 'Z') ||
+		    (character >= '0' && character <= '9') ||
+		    (character == '-' && label_length)))
+			return 0;
+		if (++label_length > 63)
+			return 0;
+	}
+	return hostname[hostname_length - 1] != '-';
+}
+
+static void socks_resolve_reply(struct ocp_sock *connection,
+			       const ip_addr_t *resolved_address)
+{
+	u8_t response[10] = { SOCKS_VER, SOCKS_HOST_UNREACHABLE, 0,
+			     SOCKS_ATYP_IPV4, 0, 0, 0, 0, 0, 0 };
+
+	if (resolved_address) {
+		response[1] = SOCKS_OK;
+		memcpy(response + 4, &resolved_address->addr, 4);
+	}
+	/* The DNS callback is complete, so deletion must release the socket. */
+	connection->state = STATE_SOCKS_CMD;
+	if (write(connection->fd, response, sizeof(response)) != sizeof(response))
+		warn("could not write SOCKS DNS response\n");
+	ocp_sock_del(connection);
+}
